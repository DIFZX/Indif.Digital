NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# CMS penjualan: /admin/login. Semua pengamanan wajib dikonfigurasi sebelum login aktif.
# Default opsional untuk script create-admin; login mendukung semua profil sales.
ADMIN_USERNAME=
ADMIN_AUTH_EMAIL=
# Hanya di server, untuk RPC pembatas login dan resolusi username privat.
# Jangan gunakan NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Site key publik widget Cloudflare Turnstile (secret key disimpan di Supabase Auth).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Lihat docs/sales-cms-setup.md untuk migrasi, akun sales, dan aktivasi CAPTCHA.

# Kosongkan selama media masih berada di public/media.
# Saat pindah ke R2, isi dengan custom domain bucket tanpa trailing slash.
# File R2 harus mempertahankan key yang sama, misalnya media/elegant/cover.webp.
NEXT_PUBLIC_MEDIA_BASE_URL=
